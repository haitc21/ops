# OPS direct-debug runtime configuration.
# Docker supplies OPS settings from its own deployment environment.
# Copy this file to .env. Never commit real credentials.

OPS_ENVIRONMENT=development
OPS_SERVICE_NAME=ops
OPS_LOG_LEVEL=INFO
OPS_RABBITMQ_URL=amqp://cmp:cmp_dev_password@127.0.0.1:5673/cmp  # pragma: allowlist secret
OPS_CPS_BASE_URL=http://127.0.0.1:8002
OPS_OPENSTACK_VERIFY_TLS=true
