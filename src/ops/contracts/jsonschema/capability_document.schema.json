    },
    "ExtraMetadataDepth2": {
      "type": "object",
      "maxProperties": 4,
      "propertyNames": {
        "$ref": "#/$defs/SafePropertyName"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
