{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InventoryBatchPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["sync_id", "resource_type", "sequence", "is_last", "item_count", "checksum"],
  "properties": {
    "sync_id": {"type": "string", "format": "uuid"},
    "resource_type": {"enum": ["domain", "region", "project", "flavor", "availability-zone", "image", "instance", "network", "subnet", "port", "volume", "volume-type", "volume-snapshot", "keypair", "role-assignment", "quota"]},
    "sequence": {"type": "integer", "minimum": 1},
    "is_last": {"type": "boolean"},
    "collection_status": {"enum": ["COMPLETE", "SKIPPED_UNSUPPORTED"]},
    "item_count": {"type": "integer", "minimum": 0},
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_resource_id", "name"],
      "properties": {
        "provider_resource_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "provider_status": {"type": ["string", "null"], "maxLength": 64},
        "provider_created_at": {"type": ["string", "null"]},
        "provider_updated_at": {"type": ["string", "null"]},
        "lifecycle_state": {"enum": ["ACTIVE", "DELETED"]},
        "project_provider_resource_id": {"type": ["string", "null"], "maxLength": 255},
        "volume_type_provider_resource_id": {"type": ["string", "null"], "maxLength": 255},
        "size_gib": {"type": ["integer", "null"], "minimum": 1, "maximum": 16384},
        "bootable": {"type": ["boolean", "null"]},
        "root": {"type": ["boolean", "null"]},
        "encrypted": {"type": ["boolean", "null"]},
        "metadata": {"type": ["object", "null"]},
        "availability_zone": {"type": ["string", "null"], "maxLength": 255},
        "attachments": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
        "volume_provider_resource_id": {"type": ["string", "null"], "maxLength": 255},
        "snapshot_size_gib": {"type": ["integer", "null"], "minimum": 1, "maximum": 16384},
        "vcpus": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "ram_mib": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777216},
        "root_disk_gib": {"type": ["integer", "null"], "minimum": 0, "maximum": 1048576},
        "ephemeral_disk_gib": {"type": ["integer", "null"], "minimum": 0, "maximum": 1048576},
        "swap_mib": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777216},
        "is_public": {"type": ["boolean", "null"]},
        "enabled": {"type": ["boolean", "null"]},
        "visibility": {"enum": ["public", "private", "shared", "community", null]},
        "is_protected": {"type": ["boolean", "null"]},
        "container_format": {"type": ["string", "null"], "minLength": 1, "maxLength": 32},
        "disk_format": {"type": ["string", "null"], "minLength": 1, "maxLength": 32},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
        "virtual_size_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
        "tags": {"type": ["array", "null"], "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "properties": {"type": ["object", "null"]},
        "checksum": {"type": ["string", "null"], "maxLength": 128},
        "min_disk_gib": {"type": ["integer", "null"], "minimum": 0, "maximum": 1048576},
        "min_ram_mib": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777216},
        "catalog_approved": {"type": ["boolean", "null"]},
        "extra_specs": {"type": ["object", "null"]},
        "access_project_ids": {"type": ["array", "null"], "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "attributes": {"type": "object"}
      }
    }
  }
}
